#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

mkdir -p "$TARGET_DIR"

cp "$SCRIPT_DIR/caldir-sync.service" "$TARGET_DIR/caldir-sync.service"
cp "$SCRIPT_DIR/caldir-sync.timer" "$TARGET_DIR/caldir-sync.timer"

systemctl --user daemon-reload
systemctl --user enable --now caldir-sync.timer

echo "Caldir background sync timer successfully installed and started."
systemctl --user list-timers --all | grep caldir
