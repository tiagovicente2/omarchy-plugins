// The installed helper is root-owned and only accepts fixed charge-limit
// operations. Let the active local desktop user call it without an auth dialog.
polkit.addRule(function(action, subject) {
  if (action.id !== "org.freedesktop.policykit.exec")
    return polkit.Result.NOT_HANDLED;

  if (action.lookup("program") === "/usr/local/bin/battery-protection" &&
      subject.active && subject.local)
    return polkit.Result.YES;

  return polkit.Result.NOT_HANDLED;
});
